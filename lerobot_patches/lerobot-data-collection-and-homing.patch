+def _read_robot_action_pose(robot: "Robot") -> dict[str, float] | None:
+    """Read the robot's current pose expressed in action space.
+
+    `send_action` applies `joint_directions` on the way out, so the raw motor
+    feedback is divided by it here to give a value that can be fed straight back
+    in as an action. Returns None if the pose could not be read.
+    """
+    keys = [key for key in robot.action_features if key.endswith(".pos")]
+    if not keys:
+        return None
+
+    directions = getattr(robot.config, "joint_directions", {})
+    try:
+        pose = {}
+        if hasattr(robot, "motors") and hasattr(robot, "bus"):
+            for motor in robot.motors.values():
+                motor.request_feedback()
+            robot.bus.poll_feedback_once()
+            stale = []
+            for key in keys:
+                motor_name = key.removesuffix(".pos")
+                state = robot.motors[motor_name].get_state()
+                if state is None:
+                    # Never substitute 0.0 here. 0.0 IS the home pose, so a failed
+                    # read would look like "already home" and collapse the ramp
+                    # into a single full-travel step command.
+                    stale.append(motor_name)
+                    continue
+                pose[key] = math.degrees(state.pos) / (directions.get(motor_name, 1.0) or 1.0)
+            if stale:
+                logging.warning(
+                    "No CAN feedback from %s; falling back to get_observation().", ", ".join(stale)
+                )
+                pose = {}
+                observation = robot.get_observation()
+                for key in keys:
+                    motor_name = key.removesuffix(".pos")
+                    if key not in observation:
+                        logging.error("Joint %s missing from observation; cannot read pose.", key)
+                        return None
+                    pose[key] = float(observation[key]) / (directions.get(motor_name, 1.0) or 1.0)
+        else:
+            observation = robot.get_observation()
+            for key in keys:
+                motor_name = key.removesuffix(".pos")
+                pose[key] = float(observation.get(key, 0.0)) / (directions.get(motor_name, 1.0) or 1.0)
+    except Exception as e:
+        logging.warning("Could not read the current robot pose: %s", e)
+        return None
+
+    return pose
+
+
+def ramp_robot_to_action(
+    robot: "Robot",
+    target_action: dict[str, float],
+    fps: int,
+    duration_s: float = 3.0,
+    label: str = "target pose",
+) -> None:
+    """Interpolate the robot from its current pose to `target_action`."""
+    if not robot.is_connected or not target_action:
+        return
+
+    start_action = _read_robot_action_pose(robot)
+    if start_action is None:
+        # Commanding the target from an unknown pose is a blind full-travel step:
+        # worse than not moving. Refuse loudly instead.
+        logging.error(
+            "Cannot read the current pose, so moving to the %s would be an abrupt "
+            "uncontrolled jump. REFUSING to move; the arm has NOT been homed.",
+            label,
+        )
+        return
+
+    steps = max(1, int(max(duration_s, 0.0) * max(fps, 1)))
+    logging.info("Moving robot to %s over %.1f seconds.", label, duration_s)
+    for step in range(1, steps + 1):
+        alpha = step / steps
+        action = {
+            key: start_action.get(key, value) + (value - start_action.get(key, value)) * alpha
+            for key, value in target_action.items()
+        }
+        robot.send_action(action)
+        precise_sleep(1 / max(fps, 1))
+
+
+def return_robot_to_home(robot: "Robot", fps: int, duration_s: float = 3.0) -> None:
+    if not robot.is_connected:
+        # Callers rely on this to guarantee a known start pose, so a skip has to
+        # be loud. `is_connected` also covers the cameras on some robots, so a
+        # dropped camera can land here with the motors perfectly fine.
+        logging.warning(
+            "Robot reports not connected; SKIPPING return-to-home. The arm is wherever it was left."
+        )
+        return
+
+    home_action = {key: 0.0 for key in robot.action_features if key.endswith(".pos")}
+    if not home_action:
+        logging.warning("Robot exposes no '.pos' action features; SKIPPING return-to-home.")
+        return
+    ramp_robot_to_action(robot, home_action, fps, duration_s, label="home position")
